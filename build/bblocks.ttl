<https://ogcincubator.github.io/bblocks-helsinki-crdwg/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - OGC CRDWG Essential Variable Blocks" ;
    dct:abstract """OGC Building Blocks for the Climate Resilience Domain Working Group (CRDWG)
